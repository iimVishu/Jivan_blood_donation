MONGODB_URI=mongodb://localhost:27017/blood-donation
NEXTAUTH_SECRET=your_super_secret_key_here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Jeevan Blood Donation <noreply@jeevan.com>"

# Application / certificate URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional verified local emergency contact; leave blank until configured.
NEXT_PUBLIC_EMERGENCY_PHONE=
ADMIN_EMAIL=
GEMINI_API_KEY=

# Razorpay: use test keys for local integration testing. Missing keys disable checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional live notification service
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SERVER_URL=
NOTIFICATION_API_TOKEN=

# Optional Discord appointment workflow
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_ADMIN_MONGODB_USER_ID=

# Local seed route is disabled by default and is never available in production.
ENABLE_DEV_SEED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
